# Copy to .env (never commit .env) and run with:
#   flutter run --dart-define-from-file=.env
# Optional. Leave empty to disable the OpenWeather source.
OPENWEATHER_API_KEY=
# MET Norway requires an identifying User-Agent with contact info (app name + site or email).
MET_NO_USER_AGENT=WeatherFusion/1.0 your-email@example.com
